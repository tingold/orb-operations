<?xml version="1.0" encoding="UTF-8"?>
<!-- JTS Buffer Operation Test Cases -->
<!-- This file contains example test cases for buffer operations -->
<!-- NOTE: The expected results in this file are simplified examples and may not match exactly -->
<!-- due to different quadrant segment settings and floating-point precision. -->
<!-- For actual JTS test fixtures, use results generated by JTS TestBuilder or the JTS library. -->
<!-- Format: Each case has a geometry (in <a> or <b>) and buffer operations with distance attributes -->
<run>
  <desc>Tests for Buffer operations with various geometry types and distances.
  Covers points, linestrings, and polygons with positive and negative distances.
  </desc>

  <case>
    <desc>Point buffer - positive distance</desc>
    <a>
      POINT (0 0)
    </a>
    <test>
      <op name="buffer" arg1="A" distance="1.0">
        POLYGON ((1 0, 0.9238795325112867 0.3826834323650898, 0.7071067811865476 0.7071067811865475, 0.38268343236508984 0.9238795325112867, 0 1, -0.3826834323650897 0.9238795325112867, -0.7071067811865475 0.7071067811865476, -0.9238795325112867 0.3826834323650899, -1 0, -0.9238795325112868 -0.3826834323650897, -0.7071067811865477 -0.7071067811865475, -0.38268343236509034 -0.9238795325112866, 0 -1, 0.38268343236509 -0.9238795325112866, 0.7071067811865474 -0.7071067811865477, 0.9238795325112865 -0.3826834323650904, 1 0))
      </op>
    </test>
  </case>

  <case>
    <desc>Point buffer - zero distance</desc>
    <a>
      POINT (5 5)
    </a>
    <test>
      <op name="buffer" arg1="A" distance="0.0">
        POLYGON EMPTY
      </op>
    </test>
  </case>

  <case>
    <desc>LineString buffer - positive distance</desc>
    <a>
      LINESTRING (0 0, 10 0)
    </a>
    <test>
      <op name="buffer" arg1="A" distance="1.0">
        POLYGON ((0 -1, 10 -1, 10 1, 0 1, 0 -1))
      </op>
    </test>
  </case>

  <case>
    <desc>LineString buffer - round caps</desc>
    <a>
      LINESTRING (0 0, 5 0)
    </a>
    <test>
      <op name="buffer" arg1="A" distance="0.5">
        POLYGON ((0 -0.5, 5 -0.5, 5 0.5, 0 0.5, 0 -0.5))
      </op>
    </test>
  </case>

  <case>
    <desc>Polygon buffer - expand (positive distance)</desc>
    <a>
      POLYGON ((0 0, 10 0, 10 10, 0 10, 0 0))
    </a>
    <test>
      <op name="buffer" arg1="A" distance="1.0">
        POLYGON ((-1 -1, 11 -1, 11 11, -1 11, -1 -1))
      </op>
    </test>
  </case>

  <case>
    <desc>Polygon buffer - shrink (negative distance)</desc>
    <a>
      POLYGON ((0 0, 10 0, 10 10, 0 10, 0 0))
    </a>
    <test>
      <op name="buffer" arg1="A" distance="-1.0">
        POLYGON ((1 1, 9 1, 9 9, 1 9, 1 1))
      </op>
    </test>
  </case>

  <case>
    <desc>Polygon with hole buffer</desc>
    <a>
      POLYGON ((0 0, 10 0, 10 10, 0 10, 0 0), (2 2, 8 2, 8 8, 2 8, 2 2))
    </a>
    <test>
      <op name="buffer" arg1="A" distance="0.5">
        POLYGON ((-0.5 -0.5, 10.5 -0.5, 10.5 10.5, -0.5 10.5, -0.5 -0.5), (1.5 1.5, 8.5 1.5, 8.5 8.5, 1.5 8.5, 1.5 1.5))
      </op>
    </test>
  </case>

  <case>
    <desc>MultiPoint buffer</desc>
    <a>
      MULTIPOINT ((0 0), (10 0))
    </a>
    <test>
      <op name="buffer" arg1="A" distance="1.0">
        MULTIPOLYGON (((1 0, 0.9238795325112867 0.3826834323650898, 0.7071067811865476 0.7071067811865475, 0.38268343236508984 0.9238795325112867, 0 1, -0.3826834323650897 0.9238795325112867, -0.7071067811865475 0.7071067811865476, -0.9238795325112867 0.3826834323650899, -1 0, -0.9238795325112868 -0.3826834323650897, -0.7071067811865477 -0.7071067811865475, -0.38268343236509034 -0.9238795325112866, 0 -1, 0.38268343236509 -0.9238795325112866, 0.7071067811865474 -0.7071067811865477, 0.9238795325112865 -0.3826834323650904, 1 0)), ((11 0, 10.923879532511287 0.3826834323650898, 10.707106781186548 0.7071067811865475, 10.38268343236509 0.9238795325112867, 10 1, 9.61731656763491 0.9238795325112867, 9.292893218813453 0.7071067811865476, 9.076120467488713 0.3826834323650899, 9 0, 9.076120467488712 -0.3826834323650897, 9.292893218813453 -0.7071067811865475, 9.61731656763491 -0.9238795325112866, 10 -1, 10.38268343236509 -0.9238795325112866, 10.707106781186548 -0.7071067811865477, 10.923879532511287 -0.3826834323650904, 11 0)))
      </op>
    </test>
  </case>

</run>
